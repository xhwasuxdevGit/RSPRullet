%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf0dbe2e02b3104aa355e618a4beea0, type: 3}
  m_Name: TutorialSettings
  m_EditorClassIdentifier: RSPRullet::TutorialSettings
  _entries:
  - _step: 0
    _text: "\uC790 \uD14C\uC774\uBE14 <color=#8E2442><b>\uC67C\uCABD</b></color>\uC744
      \uC798 \uBCF4\uAC8C\uB098. \uC6B0\uB9AC\uAC00 \uB2E4\uB8F0 \uCE74\uB4DC \uB354\uBBF8\uAC00
      \uC788\uB2E4\uB124.\n\uC774\uBC88\uC5D0 \uC4F8 \uCE74\uB4DC\uB294 \uCD1D \uC77C\uACF1
      \uC7A5\uC77C\uC138. <color=#8E2442><b>\uD55C \uAC00\uC9C0 \uBAA8\uC591</b></color>\uB9CC
      <color=#8E2442><b>\uC138 \uC7A5</b></color>\uC774\uB2C8 \uC798 \uBD10 \uB450\uAC8C.\n\uCE74\uB4DC
      \uB354\uBBF8 \uC544\uB798\uB85C \uAD6C\uC131 \uC815\uBCF4\uAC00 \uD45C\uC2DC\uB418\uB2C8,
      \uACC4\uC0B0 \uAE30\uC900\uC73C\uB85C \uC0BC\uC73C\uBA74 \uB420 \uAC78\uC138."
    _waitsForClick: 1
  - _step: 1
    _text: "\uC6B0\uC120 \uCC98\uC74C \uBF51\uC740 \uCE74\uB4DC\uC758 \uB300\uACB0\uC744
      \uD1B5\uD574 \uB204\uAC00 \uBA3C\uC800 \uC6C0\uC9C1\uC77C\uC9C0 \uC815\uD574\uC9C4\uB2E4\uB124.\n\uC774\uAE34
      \uCABD\uC774 \uCCAB \uD310\uC758 <color=#8E2442><b>\uCE74\uB4DC\uB97C \uBD84\uBC30\uD560
      \uAD8C\uB9AC</b></color>\uB97C \uAC00\uC9C0\uAC8C \uB418\uC9C0.\n\uBE44\uAE30\uBA74
      \uCE74\uB4DC\uB97C \uB2E4\uC2DC \uC11E\uC5B4, \uC2B9\uBD80\uAC00 \uB0A0 \uB54C\uAE4C\uC9C0
      \uB2E4\uC2DC \uC815\uD55C\uB2E4\uB124.\n\uBCF8 \uAC8C\uC784\uC774 \uC544\uB2C8\uB2C8,
      \uCCB4\uB825\uC740 <color=#8E2442><b>\uC904\uC9C0 \uC54A\uB294\uB2E4</b></color>\uB124.
      \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9D0\uAC8C."
    _waitsForClick: 1
  - _step: 2
    _text: "\uC774\uBC88\uC5D4 \uC790\uB124\uAC00 \uCE74\uB4DC\uB97C \uBF51\uC744
      \uCC28\uB840\uC77C\uC138...\n\uCE74\uB4DC\uB97C \uBF51\uC73C\uBA74 \uC5B4\uB5A4
      \uCE74\uB4DC\uC778\uC9C0\uB294 \uC790\uB124\uB9CC \uC54C \uC218 \uC788\uB124.\n\uCE74\uB4DC\uB97C
      \uAC16\uB4E0\uC9C0 \uC8FC\uB4E0\uC9C0 \uC790\uB124\uAC00 \uACB0\uC815\uD560
      \uC218 \uC788\uB2E4\uB124.\n\uB2F9\uC5F0\uD788 <color=#8E2442><b>\uC5CE\uC5B4\uC9C4
      \uCE74\uB4DC</b></color>\uB294 \uB098\uB294 \uBB3C\uB860 \uC790\uB124\uB3C4
      <color=#8E2442><b>\uC54C \uC218 \uC5C6\uC9C0.</b></color>\r\n"
    _waitsForClick: 0
  - _step: 3
    _text: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uCE74\uB4DC\uB97C \uBF51\uC744 \uCC28\uB840\uAD70...\n\uCE74\uB4DC\uAC00
      \uC5B4\uB5A4 \uBAA8\uC591\uC778\uC9C0\uB294 \uAEBC\uB0B8 \uC0AC\uB78C\uB9CC
      \uC54C \uC218 \uC788\uC9C0.\n<color=#8E2442><b>\uB208 \uBAA8\uC591 \uD45C\uC2DC</b></color>\uB294
      \uB0B4\uAC00 <color=#8E2442><b>\uCE74\uB4DC\uC758 \uC815\uBCF4</b></color>\uB97C
      \uC548\uB2E4\uB294 \uB73B\uC77C\uC138.\n\uCE74\uB4DC\uB97C \uBF51\uC73C\uBA74
      \uD574\uB2F9 \uCE74\uB4DC\uB97C \uC904\uC9C0 \uB9D0\uC9C0 \uC815\uD560 \uC218
      \uC788\uC9C0."
    _waitsForClick: 1
  - _step: 4
    _text: "\uC774\uB807\uAC8C \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD574 \uC2B9\uD398\uB97C
      \uAC00\uB9AC\uB294, <color=#1F4E9C><b>\uD55C \uD310 \uB2E8\uC704</b></color> 
      \uC2B9\uBD80\uAC00 \uACC4\uC18D\uD574\uC11C \uC9C4\uD589 \uB41C\uB2E4\uB124.\n\uC9C4
      \uCABD\uC740 \uCCB4\uB825 \uD558\uB098\uB97C \uC783\uACE0, \uBE44\uAE30\uBA74
      \uADF8\uB300\uB85C\uC77C\uC138. \uACB0\uACFC\uB294 \uC624\uB978\uCABD\uC5D0
      \uAE30\uB85D\uB41C\uB2E4\uB124.\n\uCE74\uB4DC\uB97C <color=#8E2442><b>\uBF51\uB294
      \uAD8C\uB9AC</b></color>\uB294 \uD56D\uC0C1 <color=#8E2442><b>\uBC88\uAC08\uC544\uAC00\uBA70</b></color>
      \uC8FC\uACE0 \uBC1B\uB294\uB2E4\uB124.\n\uBFD0\uB9CC \uC544\uB2C8\uB77C, \uC2B9\uBD80\uC5D0
      \uC0AC\uC6A9\uB41C \uCE74\uB4DC\uB294 \uB098\uC640 \uC790\uB124\uC758 <color=#1F4E9C><b>\uCE74\uB4DC
      \uD328</b></color>\uB85C \uAD6C\uC131\uB41C\uB2E4\uB124."
    _waitsForClick: 1
  - _step: 5
    _text: "\uC790 \uC774\uC81C \uCE74\uB4DC\uAC00 1\uC7A5 \uB0A8\uC558\uC73C\uB2C8
      \uB0A8\uC740 \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD558\uACE0 \uB2E4\uB978 \uCE74\uB4DC\uB97C
      \uC900\uBE44\uD574\uC57C \uD558\uB124.\n\uADF8\uC804\uC5D0 \uC544\uB798\uCABD\uC5D0
      \uBCF4\uAD00\uB41C <color=#1F4E9C><b>\uCE74\uB4DC \uD328</b></color>\uAC00
      <color=#8E2442><b>\uD2B9\uBCC4\uD55C \uAD00\uACC4</b></color>\uAC00 \uC131\uB9BD\uD558\uB294\uC9C0
      \uC0B4\uD3B4\uBCF4\uB3C4\uB85D \uD558\uC9C0.\n\uAE30\uB85D\uC9C0 \uC704\uC640
      \uC544\uB798\uB97C \uC798\uBCF4\uAC8C. \uCE74\uB4DC 3\uAC1C\uC758 \uAD00\uACC4\uC5D0
      \uB530\uB77C \uACF5\uACA9 \uBC0F \uD68C\uBCF5 \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uD55C\uB2E4\uB124.\n\uC790\uC138\uD55C
      \uB0B4\uC6A9\uC740<color=#1F4E9C><b>[\uADDC\uCE59]</b></color>\uC73C\uB85C
      \uC815\uB9AC\uD574\uBD24\uC73C\uB2C8 \uC5B8\uC81C\uB4E0\uC9C0 \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uB124."
    _waitsForClick: 0
  - _step: 6
    _text: "\uC774\uC81C \uBAB8\uD480\uAE30\uB294 \uB05D\uB0AC\uB2E4\uB124. \uC9C0\uAE08\uBD80\uD130\uAC00
      \uC9C4\uC9DC\uB77C\uACE0 \uD560 \uC218 \uC788\uC9C0.\n\uC774\uC81C\uB294 <color=#8E2442><b>\uC544\uC774\uD15C</b></color>\uC744
      \uC0AC\uC6A9\uD574 \uC880 \uB354 \uC7AC\uBBF8\uC788\uB294 \uC2B9\uBD80\uB97C
      \uC990\uACA8\uBCFC \uC218 \uC788\uB2E4\uB124.\n\uAC01 \uC544\uC774\uD15C\uC758
      \uD6A8\uACFC\uB294 \uB9C8\uCC2C\uAC00\uC9C0\uB85C <color=#1F4E9C><b>[\uADDC\uCE59]</b></color>\uC5D0
      \uC815\uB9AC\uD574 \uB450\uC5C8\uB124."
    _waitsForClick: 0
  - _step: 7
    _text: "\uC774\uC81C \uAE30\uBCF8\uC801\uC778 \uADDC\uCE59\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC740 \uBAA8\uB450 \uB05D\uB0AC\uB124.\n\uC9C0\uAE08\uBD80\uD130\uB294
      \uC790\uB124 \uC2A4\uC2A4\uB85C \uACE0\uBBFC\uD558\uACE0 \uACB0\uC815\uD574\uBCF4\uAC8C.\n\uB193\uCE5C
      \uC124\uBA85\uC740 <color=#1F4E9C><b>[\uADDC\uCE59]</b></color> \uBA54\uB274\uB97C
      \uB204\uB974\uBA74 \uB2E4\uC2DC \uD655\uC778\uD560 \uC218 \uC788\uB2E4\uB124."
    _waitsForClick: 1
  - _step: 8
    _text: "\uD760... \uC790\uB124 \uCCB4\uB825\uC774 \uBC14\uB2E5\uB098 \uBC84\uB838\uAD70.
      \uBB3C\uB860 \uAC71\uC815\uD560 \uD544\uC694\uB294 \uC5C6\uB124.\n<color=#1F4E9C><b>[\uC751\uAE09\uC57D
      \uC12D\uCDE8]</b></color>\uB97C \uB204\uB974\uBA74 \uD574\uB2F9\uB77C\uC6B4\uB4DC\uB97C
      \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uD560 \uC218 \uC788\uB2E4\uB124.\n\uC544\uC9C1
      \uAC8C\uC784\uC774 \uC775\uC219\uD558\uC9C0 \uC54A\uC744\uD14C\uB2C8 \uC124\uBA85\uB3C4
      \uAC8C\uC18D \uD574\uC8FC\uACA0\uB124."
    _waitsForClick: 0
  - _step: 9
    _text: "\uB4DC\uB514\uC5B4 \uC815\uC2E0\uC744 \uCC28\uB838\uAD6C\uB9CC \uC80A\uC740
      \uCE5C\uAD6C!\n\uC790\uB124\uAC00 \uAE68\uC5B4\uB098\uB294\uAC78 \uAE30\uB2E4\uB9AC\uB294\uAC8C
      \uC5BC\uB9C8\uB098 \uC9C0\uB8E8\uD558\uB358\uC9C0..."
    _waitsForClick: 1
  - _step: 9
    _text: "\uC5EC\uAE34 \uC5B4\uB514\uB0D0\uACE0? \uB0B4\uAC00 \uB204\uAD6C\uB0D0\uACE0?\n\uBCF4\uC2DC\uB2E4\uC2DC\uD53C
      \uB09C \uADF8\uC800 \uD754\uD558\uB514 \uD754\uD55C \uC655\uC77C\uC138. \uADF8\uB9AC\uACE0
      \uC5EC\uAE34 \uC74C..."
    _waitsForClick: 1
  - _step: 9
    _text: "\uC790\uC790 \uADF8\uB7F0\uAC8C \uBB50 \uADF8\uB807\uAC8C \uC911\uC694\uD55C\uAC00!\n\uB208\uC55E\uC5D0
      \uC774\uB807\uAC8C \uD14C\uC774\uBE14\uACFC \uCE74\uB4DC\uAC00 \uC788\uC9C0
      \uC54A\uC740\uAC00.\n\uAE4A\uAC8C \uC0DD\uAC01\uD560 \uD544\uC694 \uC5C6\uC774
      \uC77C\uB2E8 \uC990\uAE30\uBA74 \uB418\uC9C0 \uC54A\uACA0\uB098?"
    _waitsForClick: 1
  - _step: 9
    _text: "\uC544\uBB34\uB7F0 \uAC71\uC815\uD560 \uD544\uC694 \uC5C6\uB124. \uB0B4\uAC00
      \uB2E4 \uAC00\uB974\uCCD0 \uC904\uD130\uC774\uB2C8\n\uD750\uD750\uD750... \uC73C\uD760!
      \uC544\uBB34\uAC83\uB3C4 \uC544\uB2D0\uC138.\n\uC790 \uADF8\uB7FC \uC9C0\uAE08\uBD80\uD130
      \uC124\uBA85\uC744 \uC2DC\uC791\uD558\uACA0\uB124."
    _waitsForClick: 1
