--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf0dbe2e02b3104aa355e618a4beea0, type: 3}
  m_Name: TutorialSettings
  m_EditorClassIdentifier: RSPRullet::TutorialSettings
  _entries:
  - _step: 0
    _text: "\uC774\uBC88\uC5D0 \uC4F8 \uCE74\uB4DC \uC77C\uACF1 \uC7A5\uC77C\uC138.\n\uD55C
      \uC885\uB958\uB9CC \uC138 \uC7A5\uC774\uB2C8 \uC798 \uBD10 \uB450\uAC8C.\n\uB0A8\uC740
      \uC218\uB294 \uC67C\uCABD \uCE74\uB4DC\uD480\uC5D0 \uB098\uC624\uB124."
    _waitsForClick: 1
  - _step: 1
    _text: "\uCC98\uC74C \uBC1B\uC740 \uCE74\uB4DC\uB85C \uB204\uAC00 \uBA3C\uC800
      \uC6C0\uC9C1\uC774\uB294\uC9C0 \uC815\uD558\uB294 \uB2E8\uACC4\uB77C\uB124.\n\uC774\uAE34
      \uCABD\uC774 \uCCAB \uD310\uC758 \uCE74\uB4DC\uB97C \uBD84\uBC30\uD560 \uAD8C\uB9AC\uB97C
      \uAC00\uC9C0\uAC8C \uB418\uC9C0.\n\uBE44\uAE30\uBA74 \uCE74\uB4DC\uB97C \uB2E4\uC2DC
      \uC11E\uC5B4 \uC2B9\uBD80\uAC00 \uB0A0 \uB54C\uAE4C\uC9C0 \uB2E4\uC2DC \uC815\uD55C\uB2E4\uB124.\n\uBCF8
      \uAC8C\uC784\uC774 \uC544\uB2C8\uB2C8 \uCCB4\uB825\uC740 \uC904\uC9C0 \uC54A\uB294\uB2E4\uB124.
      \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9D0\uAC8C."
    _waitsForClick: 1
  - _step: 2
    _text: "\uCE74\uB4DC\uB97C \uBF51\uC73C\uBA74 \uC5B4\uB5A4 \uCE74\uB4DC\uC778\uC9C0\uB294
      \uC790\uB124\uB9CC \uC54C \uC218 \uC788\uB124.\n\uCE74\uB4DC\uB97C \uAC16\uB4E0\uC9C0
      \uC8FC\uB4E0\uC9C0 \uC790\uB124\uAC00 \uACB0\uC815\uD560 \uC218 \uC788\uB2E4\uB124.\n\uB2F9\uC5F0\uD788
      \uC5CE\uC5B4\uC9C4 \uCE74\uB4DC\uB294 \uB098\uB294 \uBB3C\uB860 \uC790\uB124\uB3C4
      \uC54C \uC218 \uC5C6\uC9C0."
    _waitsForClick: 0
  - _step: 3
    _text: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uBF51\uC544\uBCF4\uACA0\uB124.\n\uB208
      \uBAA8\uC591 \uD45C\uC2DC\uB294 \uB0B4\uAC00 \uCE74\uB4DC\uC758 \uC815\uBCF4\uB97C
      \uC548\uB2E4\uB294 \uB73B\uC77C\uC138.\n\uB098 \uC5ED\uC2DC \uCE74\uB4DC\uB97C
      \uC904\uC9C0 \uB9D0\uC9C0 \uC815\uD560 \uC218 \uC788\uC9C0."
    _waitsForClick: 1
  - _step: 4
    _text: "\uC774\uC81C \uBCF8\uACA9\uC801\uC778 \uC2B9\uBD80 \uB2E8\uACC4\uB77C\uB124.
      \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD574 \uC2B9\uD328\uB97C \uC815\uD574 \uBCF4\uB3C4\uB85D
      \uD558\uC9C0.\n\uC9C4 \uCABD\uC740 \uCCB4\uB825 \uD558\uB098\uB97C \uC783\uACE0,
      \uBE44\uAE30\uBA74 \uADF8\uB300\uB85C\uC77C\uC138. \uACB0\uACFC\uB294 \uC624\uB978\uCABD\uC5D0
      \uAE30\uB85D\uB41C\uB2E4\uB124.\n\uBCF4\uB2E4\uC2DC\uD53C \uCE74\uB4DC\uB97C
      \uBF51\uB294 \uCC28\uB840\uB294 \uC8FC\uACE0\uBC1B\uB294\uB2E4\uB124."
    _waitsForClick: 1
  - _step: 5
    _text: "\uC790 \uC774\uC81C \uCE74\uB4DC\uAC00 1\uC7A5 \uB0A8\uC558\uC73C\uB2C8
      \uB0A8\uC740 \uCE74\uB4DC\uB97C \uACF5\uAC1C\uD558\uACE0 \uB2E4\uB978 \uCE74\uB4DC\uB97C
      \uC900\uBE44\uD574\uC57C \uD558\uB124.\n\uADF8\uC804\uC5D0 \uC9C0\uAE08\uAE4C\uC9C0
      \uBCF4\uAD00\uD55C \uCE74\uB4DC 3\uC7A5\uC774 \uD2B9\uBCC4\uD55C \uAD00\uACC4\uAC00
      \uC131\uB9BD\uD558\uB294\uC9C0 \uC0B4\uD3B4\uBCF4\uB3C4\uB85D \uD558\uC9C0.\n\uAE30\uB85D\uC9C0
      \uC704\uC640 \uC544\uB798\uB97C \uC798\uBCF4\uAC8C. \uCE74\uB4DC 3\uAC1C\uC758
      \uAD00\uACC4\uC5D0 \uB530\uB77C \uACF5\uACA9 \uBC0F \uD68C\uBCF5 \uD6A8\uACFC\uAC00
      \uBC1C\uB3D9\uD55C\uB2E4\uB124.\n\uC790\uC138\uD55C \uB0B4\uC6A9\uC740 [\uADDC\uCE59]\uC73C\uB85C
      \uC815\uB9AC\uD574\uBD24\uC73C\uB2C8 \uC5B8\uC81C\uB4E0\uC9C0 \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uB124."
    _waitsForClick: 0
  - _step: 6
    _text: "\uC774\uC81C \uBAB8\uD480\uAE30\uB294 \uB05D\uB0AC\uB2E4\uB124. \uC9C0\uAE08\uBD80\uD130\uAC00
      \uC9C4\uC9DC\uB77C\uACE0 \uD560 \uC218 \uC788\uC9C0.\n\uC774\uC81C\uB294 \uC544\uC774\uD15C\uC744
      \uC0AC\uC6A9\uD574 \uC880 \uB354 \uC7AC\uBBF8\uC788\uB294 \uC2B9\uBD80\uB97C
      \uC990\uACA8\uBCFC \uC218 \uC788\uB2E4\uB124.\n\uAC01 \uC544\uC774\uD15C\uC758
      \uD6A8\uACFC\uB294 \uB9C8\uCC2C\uAC00\uC9C0\uB85C [\uADDC\uCE59]\uC5D0 \uC815\uB9AC\uD574
      \uB450\uC5C8\uB124."
    _waitsForClick: 0
  - _step: 7
    _text: "\uC774\uC81C \uAE30\uBCF8\uC801\uC778 \uADDC\uCE59\uC5D0 \uB300\uD55C
      \uC124\uBA85\uC740 \uBAA8\uB450 \uB05D\uB0AC\uB124.\n\uC9C0\uAE08\uBD80\uD130\uB294
      \uC790\uB124 \uC2A4\uC2A4\uB85C \uACE0\uBBFC\uD558\uACE0 \uACB0\uC815\uD574\uBCF4\uAC8C.\n\uB193\uCE5C
      \uC124\uBA85\uC740 [\uADDC\uCE59] \uBA54\uB274\uB97C \uB204\uB974\uBA74 \uB2E4\uC2DC
      \uD655\uC778\uD560 \uC218 \uC788\uB2E4\uB124."
    _waitsForClick: 1
